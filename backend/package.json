{
  "name": "batfin-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-super-admin.ts",
    "analytics:fixture": "tsx scripts/import-analytics-fixture.ts",
    "analytics:benchmark": "tsx scripts/benchmark-analytics.ts",
    "portfolio:import": "tsx scripts/import-portfolio.ts",
    "portfolio:qa": "tsx scripts/qa-portfolio-live-sync.ts",
    "customers:import-lms": "tsx scripts/import-customer-identities.ts",
    "data:seed": "tsx scripts/seed-business-data.ts",
    "test:analytics": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "6.12.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.17.2",
    "prisma": "6.12.0",
    "tsx": "^4.20.4",
    "typescript": "~5.8.3"
  }
}
