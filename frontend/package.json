{
  "name": "batfin-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm run typecheck && npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "mobile:build:android-emulator": "tsc -b && vite build --mode mobile-android-emulator",
    "mobile:build:ios-simulator": "tsc -b && vite build --mode mobile-ios-simulator",
    "mobile:build:sandbox": "tsc -b && vite build --mode mobile-sandbox",
    "mobile:sync:android:emulator": "npm run mobile:build:android-emulator && cap sync android",
    "mobile:sync:ios:simulator": "npm run mobile:build:ios-simulator && cap sync ios",
    "mobile:sync:android:sandbox": "npm run mobile:build:sandbox && cap sync android",
    "mobile:sync:ios:sandbox": "npm run mobile:build:sandbox && cap sync ios",
    "mobile:apk:emulator": "npm run mobile:sync:android:emulator && cd android && ./gradlew assembleDebug",
    "mobile:apk:sandbox": "npm run mobile:sync:android:sandbox && cd android && ./gradlew assembleDebug",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "mobile:assets": "python3 scripts/generate-mobile-assets.py",
    "mobile:doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "lucide-react": "^1.31.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  }
}
